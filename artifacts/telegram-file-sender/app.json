{
  "expo": {
    "name": "Telegram File Sender",
    "slug": "telegram-file-sender",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/telegram-file-sender-icon.png",
    "scheme": "telegram-file-sender",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "permissions": ["REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["*/*"],
            "multipleShareMimeTypes": ["*/*"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
